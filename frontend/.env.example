# URL del backend, con el prefijo /api/v1 incluido: lib/api.ts concatena las
# rutas directo sobre esta base.
#   Local: http://localhost:3000/api/v1
#   Dev:   https://pvcarbackend-development.up.railway.app/api/v1
#   Prod:  https://pvcarbackend-production.up.railway.app/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# Supabase — la anon key es PUBLICA por diseño y se usa SOLO para Auth (login/sesion).
# Ningun dato de negocio pasa por aqui: todo va por VITE_API_URL.
# Local/dev apunta a PVCAR_Dev; produccion a PVCAR.
VITE_SUPABASE_URL=https://<ref-de-PVCAR_Dev>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Dos cosas que muerden en Vercel:
#
# 1. Las VITE_* se hornean en el bundle en tiempo de build, no se leen en
#    runtime. Cambiarlas en el dashboard no surte efecto hasta el build
#    siguiente.
#
# 2. Vercel salta el build cuando el commit no toca frontend/** (el Root
#    Directory del proyecto). Un commit solo de backend no genera preview
#    nuevo: aparece como "Canceled", sin logs de build.
