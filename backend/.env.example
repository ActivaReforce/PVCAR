# --- Servidor ---
PORT=3000
NODE_ENV=development
# Origen permitido para CORS (URL del frontend).
# Local: http://localhost:5173 | Preview: https://<proyecto>.vercel.app | Prod: https://activareforce.com
FRONTEND_ORIGIN=http://localhost:5173

# --- Supabase ---
# URL del proyecto (Settings -> API). Local/dev apunta a PVCAR_Dev.
SUPABASE_URL=https://<ref-de-PVCAR_Dev>.supabase.co
# service_role key (SECRETA, Settings -> API). NUNCA en frontend ni en git.
SUPABASE_SERVICE_ROLE_KEY=
# anon key (publica)
SUPABASE_ANON_KEY=

# --- Base de datos (Postgres directo, pg pool) ---
# Connection string del POOLER (Settings -> Database). SECRETA.
# Solo se usa para transacciones y agregaciones SQL.
# postgresql://postgres.<ref>:<password>@aws-...pooler.supabase.com:6543/postgres
DATABASE_URL=

# Nota: los tokens de Supabase Auth se validan via supabase.auth.getUser().
# NO se necesita JWT secret.
